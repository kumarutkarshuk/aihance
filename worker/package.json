{
  "name": "aihance-api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "wrangler d1 migrations apply aihance --local",
    "db:seed": "wrangler d1 execute aihance --local --file=seed/seed.sql",
    "seed:posts": "bun run scripts/seed-posts.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.48",
    "@cloudflare/workers-types": "^4.20250317.0",
    "typescript": "~5.9.2",
    "vitest": "~3.0.9",
    "wrangler": "^4.6.0"
  }
}
